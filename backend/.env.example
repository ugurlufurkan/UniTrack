# UniTrack backend — ortam değişkenleri şablonu.
# Bu dosyayı kopyalayıp `.env` yap, gerçek değerleri doldur.
# `.env` asla commit edilmez (bkz. .gitignore).

# Postgres bağlantı adresi. Prod'da hosting sağlayıcının (Render/Railway/Neon/Supabase)
# verdiği bağlantı dizesini kullan — localhost DEĞİL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unitrack

PORT=5000

NODE_ENV=development

# Access/refresh token imzalama secret'ları. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# İkisi de birbirinden FARKLI, en az 64 byte rastgele değer olmalı.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google Cloud Console > OAuth 2.0 Client IDs altındaki "Web application" client ID'si.
GOOGLE_CLIENT_ID=

# Opsiyonel — PDF transkript metnini Gemini ile çözümlemek için.
# Boş bırakılırsa yerel kural tabanlı çözümleyici kullanılır.
GEMINI_API_KEY=

# Prod'da mobil uygulama origin göndermediği için CORS'u etkilemez ama
# doğrudan tarayıcı erişimi olacaksa virgülle ayrılmış allow-list.
# Next.js portalı aynı kökendeki sunucu proxy'sini kullanır.
ALLOWED_ORIGINS=https://unitrack.app

FRONTEND_URL=http://localhost:3000

# Web BFF ile aynı, en az 32 karakter rastgele sunucu sırrı (NEXT_PUBLIC_ kullanma).
WEB_PROXY_SECRET=
# Yalnızca güvenilen ingress arkasında: hop sayısı veya virgülle ayrılmış CIDR.
# Doğrudan internete açılan backend'de boş bırak.
TRUST_PROXY=

# Üretimde zorunlu; geliştirmede e-postalar konsola yazılır.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# İsteğe bağlı web hatırlatmaları; npm run push:keys ile eşleşen anahtarlar üret.
# Ayrı worker: npm run build && npm run push:worker
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.com
PUSH_TIMEZONE=Europe/Istanbul
