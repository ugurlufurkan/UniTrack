# Copy to ops/.env. Never commit real credentials.
WEB_DOMAIN=students.example.com
API_DOMAIN=api.example.com
OPS_EMAIL=operator@example.com
# Generate each independently: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
WEB_PROXY_SECRET=
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Explicitly enable external alerts only after configuring your own receiver.
ENABLE_EXTERNAL_ALERTS=false
ALERT_WEBHOOK_URL=
# Encrypt backups to a public age recipient. Keep its private identity separately.
AGE_RECIPIENT=
BACKUP_IDENTITY_FILE=./keys/backup.agekey
BACKUP_ENABLED=false
