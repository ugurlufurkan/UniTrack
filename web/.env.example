# Express API. Yalnızca Next.js sunucusunda kullanılır; tarayıcıya gönderilmez.
API_URL=http://127.0.0.1:5000/api/v1
# İsteğe bağlı: Web uygulaması için Google OAuth istemci kimliği.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Üretimde zorunlu: backend ile aynı, en az 32 karakter sunucu sırrı.
WEB_PROXY_SECRET=
# Ingress'in istemciden gelen değeri ezerek sağladığı IP başlığı.
# Sağlanan Caddy kurulumu için: x-forwarded-for
WEB_CLIENT_IP_HEADER=
